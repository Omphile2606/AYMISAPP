<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="40dp"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/btn"
                android:textStyle="bold"
                android:text="AYIMS"
                android:textSize="25sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:layout_marginStart="90dp"
                android:drawableLeft="@drawable/outline_account_circle_24"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:layout_marginStart="16dp"
                android:drawableLeft="@drawable/outline_chat_bubble_24"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:layout_marginStart="16dp"
                android:drawableLeft="@drawable/outline_account_circle_24"/>

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule a Lesson"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Student"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <AutoCompleteTextView
                    android:id="@+id/studentAutoComplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search for a student"
                    android:padding="12dp"
                    android:background="@drawable/math_formula_svgrepo_com"
                    android:completionThreshold="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Subject"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/tutorSubjectGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbMath" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Math" android:layout_marginEnd="10dp"/>
                    <RadioButton android:id="@+id/rbPhysics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physics" android:layout_marginEnd="10dp"/>
                    <RadioButton android:id="@+id/rbBiology" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biology"/>
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Date"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <CalendarView
                    android:id="@+id/scheduleCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/Widget.AppCompat.CalendarView"/>

                <Button
                    android:id="@+id/btnScheduleLesson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Schedule Lesson"
                    android:backgroundTint="@color/btn"
                    android:textColor="@color/white"
                    android:layout_marginTop="24dp"
                    android:padding="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
