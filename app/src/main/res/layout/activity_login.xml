<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LoginActivity">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My-Tutor"
        android:textColor="@color/btn"
        android:drawableLeft="@drawable/outline_aspect_ratio_24"
        android:textAllCaps="true"
        android:textSize="35sp"
        android:layout_marginTop="48dp"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back"
        android:textSize="32sp"
        android:layout_marginTop="23dp"
        android:layout_marginHorizontal="40dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please enter your details to access your dashboard."
        android:textSize="18sp"
        android:layout_marginTop="7.1dp"
        android:layout_marginHorizontal="40dp"/>



    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="26dp"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textInput"
            android:inputType="textEmailAddress"
            android:text="Email"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="26dp"
        app:passwordToggleEnabled="true"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textInput"
            android:inputType="textPassword"
            android:text="Password"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="forgot Password?"
        android:textColor="@color/btn"
        android:textSize="14sp"
        android:layout_gravity="end"
        android:layout_marginTop="7.1dp"
        android:layout_marginHorizontal="40dp"/>

    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:id="@+id/loginBtn"
        android:layout_height="61dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="20dp"
        android:text="Sign in"
        android:backgroundTint="@color/btn"
        app:cornerRadius="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/register"
        android:text="Already have an account? Log In"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:layout_marginHorizontal="40dp"/>

</LinearLayout>